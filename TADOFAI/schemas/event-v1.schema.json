{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tadofai.local/schemas/event-v1.schema.json",
  "title": "TADOFAI handshake / event message v1",
  "description": "Mod 上行与 Core 转发给插件的事件流消息。逐条发送，低延迟优先；id 单调递增，用于检测丢失或重复。状态帧见 state-v1.schema.json。字段一律 camelCase。",
  "type": "object",
  "required": ["type", "version", "timestamp", "data"],
  "properties": {
    "type": {
      "enum": ["hello", "hit", "game.start", "game.end", "map.changed", "state.changed", "death", "checkpoint"]
    },
    "version": { "const": 1 },
    "timestamp": { "type": "number" },
    "id": {
      "type": ["integer", "null"],
      "minimum": 0,
      "description": "Mod 侧单调递增的事件号；state 消息没有 id"
    },
    "data": { "type": "object" }
  },
  "additionalProperties": true,
  "allOf": [
    {
      "if": { "properties": { "type": { "const": "hello" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/hello" } } }
    },
    {
      "if": { "properties": { "type": { "const": "hit" } } },
      "then": { "properties": { "data": { "$ref": "#/$defs/hit" } } }
    },
    {
      "if": {
        "properties": {
          "type": { "enum": ["game.start", "game.end", "map.changed", "state.changed", "death", "checkpoint"] }
        }
      },
      "then": { "properties": { "data": { "$ref": "#/$defs/gameEvent" } } }
    }
  ],
  "$defs": {
    "hello": {
      "type": "object",
      "description": "连接后的第一帧，声明客户端身份与能力",
      "properties": {
        "client": { "type": "string", "maxLength": 64 },
        "modVersion": { "type": "string", "maxLength": 64 },
        "gameVersion": { "type": "string", "maxLength": 64 },
        "protocolVersion": { "type": "integer", "minimum": 0 },
        "capabilities": {
          "type": "array",
          "items": { "type": "string" },
          "maxItems": 32,
          "description": "运行时探测的能力位。前端必须先看这里再决定渲染哪些块；出现在列表里就保证对应字段可读。",
          "examples": [[
            "hit", "timing", "accuracy", "bpm", "progress",
            "xperfect", "hitmargins", "mapmeta", "timeline", "coop",
            "checkpoint", "paused", "fps", "timingwindows", "kps", "pseudobpm", "checkpointtiles",
            "perfectcombo"
          ]]
        },
        "difficulty": {
          "type": "string",
          "maxLength": 32,
          "description": "难度名（Lenient / Normal / Strict）"
        },
        "hitMarginNames": {
          "type": "array",
          "description": "下标 = HitMargin 枚举值。state.players[].hitMargins 与 hit.judgement 都靠它翻译",
          "items": { "type": "string", "maxLength": 64 },
          "maxItems": 32
        },
        "hitMarginWeights": {
          "type": "array",
          "description": "下标 = HitMargin 枚举值；精度权重（XPerfect=2，±Perfect=1，其余 0）",
          "items": { "type": "number" },
          "maxItems": 32
        },
        "hitMarginXScores": {
          "type": "array",
          "description": "下标 = HitMargin 枚举值；XScore 分值",
          "items": { "type": "integer" },
          "maxItems": 32
        }
      },
      "additionalProperties": true
    },
    "hit": {
      "type": "object",
      "properties": {
        "player": { "type": "integer", "minimum": 0, "maximum": 16 },
        "seq": { "type": "integer", "minimum": 0 },
        "judgement": {
          "type": "string",
          "maxLength": 64,
          "description": "游戏判定枚举名，例如 PerfectPlus / EarlyPerfect / XPerfect / FailMiss；不同版本取值不同，不要写死白名单"
        },
        "timingMs": {
          "type": "number",
          "description": "游戏内 Patch 触发时记录的 Timing，不是网络到达时间"
        },
        "combo": { "type": "integer", "minimum": 0, "description": "这一下之后的完美连击数" },
        "miss": { "type": "boolean", "description": "true 表示这一下断 Combo（fail 系判定）" },
        "perfect": {
          "type": "boolean",
          "description": "这一下是否中心完美判定（决定 Combo 是否继续增长）。中心完美 = 有 XPerfect 的版本取 PerfectMinus/XPerfect/PerfectPlus，否则取 Perfect"
        },
        "perfectCombo": {
          "type": "boolean",
          "description": "这一下之后 Combo 是否仍是完美连击"
        },
        "xScore": { "type": "integer", "minimum": 0, "description": "这一下之后的 X 分数" },
        "judged": { "type": "integer", "minimum": 0, "description": "这一下之后的已判定数" },
        "purePerfect": { "type": "boolean", "description": "这一下之后是否仍保持纯完美" }
      },
      "additionalProperties": true
    },
    "gameEvent": {
      "type": "object",
      "properties": {
        "seq": { "type": "integer", "minimum": 0 },
        "combo": { "type": "integer", "minimum": 0 },
        "detail": {
          "type": "string",
          "maxLength": 512,
          "description": "checkpoint 事件里是 \"checkpoints=N\"；state.changed 里是 \"auto=true|false\""
        }
      },
      "additionalProperties": true
    }
  }
}
